# ============================================================================
# CLIENT-SAFE variables only. Everything prefixed VITE_ is bundled into the
# browser build and is PUBLIC. Never put secrets here.
# ============================================================================

# Supabase project URL (safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase ANON/PUBLIC key (safe to expose — it is subject to Row Level
# Security, and every Phase-1 table has RLS enabled with no permissive
# policies for anon/authenticated, so this key alone cannot read/write
# tenant data).
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the trusted server-side API (Supabase Edge Functions) hosting
# the Phase 2 login, session, and other privileged endpoints. Edge Functions
# live at ${SUPABASE_URL}/functions/v1/<function-name>, so this should be
# ${VITE_SUPABASE_URL}/functions/v1 once supabase/functions/* are deployed
# (see supabase/functions/README.md). Falls back to localhost for running
# a local `supabase functions serve` during development.
VITE_API_BASE_URL=https://yvxsyvgccxdvmgazvofm.supabase.co/functions/v1

# ============================================================================
# SERVER-ONLY variables. These must NEVER be prefixed with VITE_, must NEVER
# be read by frontend code, and must NEVER be committed to git. They belong
# only in the environment of whatever secure server/edge-function runtime
# hosts server/ (e.g. Supabase Edge Function secrets, a hosting provider's
# environment variable manager, or a local .env loaded only by the server
# process). See docs/ARCHITECTURE.md § Client/Server Separation.
# ============================================================================

# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=__NEVER_COMMIT__NEVER_SEND_TO_BROWSER__
# SESSION_TOKEN_PEPPER=__server_only_random_secret__
# PASSWORD_HASH_PEPPER=__server_only_random_secret__
